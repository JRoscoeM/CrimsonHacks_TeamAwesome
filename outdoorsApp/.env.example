# Copy this file to .env and fill in your own values.
# .env is gitignored. NEVER commit real keys (this file is committed, so keep it blank).

# --- Have already -------------------------------------------------------------

# Recreation.gov RIDB: federal campgrounds, rec areas, facilities
# https://ridb.recreation.gov/profile
RIDB_API_KEY=

# Google Maps Platform: one key covers Places (ratings, reviews, accessibility),
# Weather, Geocoding, Routes (drive times), Air Quality, and the Maps JS map.
# Enable each API in Cloud Console, restrict the key, and set a budget alert.
# https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=

# --- Need to sign up (free) ---------------------------------------------------

# National Park Service: parks, alerts/closures, fees, activities, amenities, campgrounds
# https://www.nps.gov/subjects/developer/get-started.htm
NPS_API_KEY=

# UDOT Traffic: road conditions, closures, canyon status, cameras
# https://www.udottraffic.utah.gov/developers/doc
UDOT_API_KEY=

# --- Optional -----------------------------------------------------------------

# NOAA NCEI Climate Data Online: typical weather by date (Open-Meteo is the no-key alternative)
# https://www.ncdc.noaa.gov/cdo-web/token
NOAA_CDO_TOKEN=

# AirNow: air quality and wildfire smoke (Google Air Quality API is the alternative)
# https://docs.airnowapi.org/account/request/
AIRNOW_API_KEY=

# No key needed: Open-Meteo, NPS visitor stats, NRCS SNOTEL, UGRC/SGID, OSM Overpass, NIFC
